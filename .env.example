# HMAC secret for round tokens and receipts. Any long random string.
BARRICADE_SECRET=

# 32-byte base64 key that unseals content/sealed/*.enc (pnpm content:keygen).
# Without it the app serves the public sample pack.
BARRICADE_SEAL_KEY=

# First puzzle date (YYYY-MM-DD). Puzzle #1 is played on this day.
BARRICADE_EPOCH=2026-11-09

# Optional: Upstash Redis (Vercel Marketplace) for crowd stats.
# Either naming works. Without them, stats live in memory (dev only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Public base URL used in share text and OG tags.
NEXT_PUBLIC_SITE_URL=https://fstvl.xyz
