# HMAC secret for round tokens and receipts. Any long random string.
# Use a different one per Vercel environment (Production / Preview / Development).
BARRICADE_SECRET=

# 32-byte base64 key that unseals content/sealed/*.enc (pnpm content:keygen).
# Production (NODE_ENV=production) needs it whenever content/sealed/pack.json.enc
# is committed: a sealed pack without its key is a hard error, never a fallback.
# In local dev, without it the app falls back to content/build, then the sample.
BARRICADE_SEAL_KEY=

# Production refuses to serve the PUBLIC sample pack (its answers are in the
# repo). Set to 1 only for a deliberate demo deploy (e.g. Vercel Preview).
# BARRICADE_ALLOW_SAMPLE=1

# First puzzle date (YYYY-MM-DD). Puzzle #1 is played on this day.
BARRICADE_EPOCH=2026-11-09

# Optional: Upstash Redis (Vercel Marketplace) for crowd stats and answer reports.
# Either naming works. Without them, stats live in memory (dev only).
# Every key is namespaced b:{VERCEL_ENV || NODE_ENV}:{pack kind}:…, so Preview,
# dev and sample-pack plays never mix into production's numbers even when the
# environments share one database.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Public base URL used in share text and OG tags.
NEXT_PUBLIC_SITE_URL=https://fstvl.xyz
