# Vercel CLI deploys do not read .gitignore. Keep the plaintext spoilers and
# local keys out of the uploaded source: production content ships ONLY as
# content/sealed/*.enc (+ the public content/sample/pack.json).
content/source
content/build
.env*
!.env.example

# Local builds and QA caches never belong in a source upload.
.next*
node_modules
*.tsbuildinfo
