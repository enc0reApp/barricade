{
  "name": "barricade",
  "version": "0.1.0",
  "private": true,
  "description": "BARRICADE — the daily push to the front. A rarity trivia game about live music, festivals and the culture around them.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx scripts/check-source.ts",
    "content:fame": "tsx scripts/fetch-fame.ts",
    "content:build": "tsx scripts/build-content.ts",
    "content:sample": "tsx scripts/build-content.ts --sample",
    "content:seal": "tsx scripts/seal.ts",
    "content:unseal": "tsx scripts/unseal.ts",
    "content:report": "tsx scripts/tier-report.ts",
    "content:keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "tsx": "4.23.15"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
